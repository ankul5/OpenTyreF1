# API URL used by the Expo app.
#
# EXPO_PUBLIC_* is inlined at BUILD time, not read at runtime — changing this
# does nothing to an APK that is already built. Rebuild after editing.
#
# A non-LAN URL like this one always wins, including in development, so both
# `expo start` and release builds talk to the deployed backend. To develop
# against a local backend instead, comment this line out: src/services/api.ts
# then derives the address from the Metro host and follows your LAN IP
# automatically.
EXPO_PUBLIC_API_URL=https://opentyreapi.onrender.com
