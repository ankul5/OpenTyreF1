# API URL used by the Expo app.
#
# In development you normally do NOT need to touch this: src/services/api.ts
# derives the backend address from the Metro host the device already connected
# to, so it follows your PC's LAN IP automatically when the router reassigns it.
#
# This value matters for RELEASE builds (EXPO_PUBLIC_* is inlined at build time,
# not read at runtime — changing it does nothing to an APK that is already
# built). Point it at the deployed backend before running `eas build`:
#
#   EXPO_PUBLIC_API_URL=https://opentyref1-api.onrender.com
#
# A non-LAN URL like the one above always wins, including in development.
EXPO_PUBLIC_API_URL=http://10.137.147.17:8000
