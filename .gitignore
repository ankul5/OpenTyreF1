# Python / Backend
backend/venv/
backend/__pycache__/
backend/app/__pycache__/
backend/app/*/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Local scratch databases. The shipped dataset (backend/opentyref1.db) is
# committed on purpose so the repo is runnable and inspectable without a
# 30-minute ingestion run — see DATASETS.md.
*.db
!backend/opentyref1.db

# backend/.env holds the real DATABASE_URL once Supabase is wired up
# (password included) — must never be committed. opentyref1/.env stays
# tracked on purpose: it only holds a public API URL, nothing secret.
backend/.env

# FastF1 HTTP/pickle cache — regenerates on first run, don't ship it.
backend/cache/

# Node / React Native / Expo
node_modules/
opentyref1/node_modules/
opentyref1/.expo/
.expo/
dist/
web-build/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Machine-local Claude Code settings (shared settings.json stays tracked)
.claude/settings.local.json
**/.claude/settings.local.json
